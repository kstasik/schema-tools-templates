{% elif froms is not containing(pat=response.models["default"]?.model?.model?.name) %}
impl From<{% if filtered_response_headers | length == 0 %}{{ <type property={response.models["default"]?.model} ns="super::model"/> }}{% else %}{{ <type property={response.models["default"]?.model} ns=""/> }}WithHeaders{% endif %}> for HttpResponse {
    fn from(d: {% if filtered_response_headers | length == 0 %}{{ <type property={response.models["default"]?.model} ns="super::model"/> }}{% else %}{{ <type property={response.models["default"]?.model} ns=""/> }}WithHeaders{% endif %}) -> HttpResponse {
        let mut builder = HttpResponse::build(StatusCode::from_u16({{ response.statusCode }}).unwrap());

        {% if [item for item in filtered_response_headers if item.required == true] | length > 0 %}
        builder
            {% for param in [item for item in filtered_response_headers if item.required == true] %}
            .append_header((HeaderName::from_static("{{ param.name | lower }}"), d.headers.{{ <property_name name={param.name}/> }}))
            {% endfor %};
        {% endif %}

        {% for param in [item for item in filtered_response_headers if item.required == false]  %}
        if let Some(header) = d.headers.{{ <property_name name={param.name}/> }} {
            builder.append_header((HeaderName::from_static("{{ param.name | lower }}"), header));
        }
        {% endfor %}

        builder.json({% if filtered_response_headers | length == 0 %}d{% else %}d.body{% endif %})
    }
}

