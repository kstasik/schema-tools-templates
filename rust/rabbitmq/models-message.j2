{# type=models,filename=rabbitmq/message.rs,min_version=1.0.0 #}
{% extends "models.j2" %}
{% block use %}
use lapin::types::{AMQPValue, LongString, ShortString};
{% if formats is not containing(pat="date-time") or formats is containing(pat="date") %}
use chrono::{DateTime, Utc};
{% endif %}
use lapin::types::FieldTable;
{% endblock use %}

{% block end %}

fn generate_time_string() -> String {
    let now = std::time::SystemTime::now();
    let now: DateTime<Utc> = now.into();

    now.to_rfc3339()
}
{% endblock end %}
